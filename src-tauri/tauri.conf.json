{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Copybook",
  "version": "../package.json",
  "identifier": "io.github.wio-ki.copybook",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "panel", "url": "panel.html", "title": "Copybook", "width": 384, "height": 576, "minWidth": 320, "minHeight": 420, "decorations": false, "shadow": true, "resizable": true, "maximizable": false, "alwaysOnTop": true, "skipTaskbar": true, "visible": false, "focus": true },
      { "label": "settings", "url": "settings.html", "title": "Copybook — Settings", "width": 760, "height": 560, "minWidth": 640, "minHeight": 480, "decorations": false, "shadow": true, "resizable": true, "skipTaskbar": false, "visible": false, "center": true }
    ],
    "security": {
      "assetProtocol": { "enable": true, "scope": ["$APPDATA/images/**", "$APPDATA/icons/**"] },
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "useLocalToolsDir": true,
    "active": true,
    "targets": ["nsis"],
    "publisher": "wio-ki",
    "shortDescription": "Clipboard history for Windows",
    "licenseFile": "../LICENSE",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": { "nsis": { "installMode": "currentUser", "languages": ["SimpChinese", "English"], "displayLanguageSelector": true } }
  }
}
