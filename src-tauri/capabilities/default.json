{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Copybook local windows",
  "windows": ["panel", "settings"],
  "permissions": [
    "core:default", "core:window:allow-start-dragging", "core:window:allow-minimize",
    "core:window:allow-toggle-maximize", "core:window:allow-hide", "core:window:allow-close",
    "core:window:allow-set-focus", "core:event:default", "allow-copybook"
  ]
}
